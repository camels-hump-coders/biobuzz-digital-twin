{
  "$schema": "../scenario.schema.json",
  "name": "FRAME-FRONT: shooter-first drive-out with the stock front shooter moves toward the field centre",
  "opMode": "BioBuzz: Auto 30s + Drive",
  "alliance": "blue",
  "assetOverrides": {
    "biobuzz/robot-profile.json": {
      "matchAuto.enabled": true,
      "tagTracking.autoShootEnabled": false,
      "matchAuto.startPosition": "LOADING_ZONE",
      "matchAuto.driveOutIn": 6,
      "matchAuto.drivePower": 0.15,
      "matchAuto.collectGarden": false,
      "matchAuto.timeoutSeconds": 10,
      "matchAuto.returnReserveSeconds": 3
    }
  },
  "start": {
    "xIn": 60,
    "zIn": 0,
    "headingDeg": 90
  },
  "opponents": false,
  "durationS": 1.5,
  "inputs": [],
  "expect": {
    "noErrors": true,
    "telemetryIncludes": [
      "Route forward : SHOOTER-FIRST \\(front chassis\\)",
      "Match auto : DRIVE_OUT"
    ],
    "poseNear": {
      "xIn": 51,
      "zIn": 0,
      "tolIn": 5
    },
    "movedAtLeastIn": 3
  },
  "notes": "Handoff P0 FRAME (the team's auto-shooter-first-front). Route forward is shooter-first; with a front shooter the chassis drives forward. The pose check fails if a sign is wrong (the robot would move into the wall).",
  "robotPreset": "starterbot6wd",
  "hardwarePreset": "camelsHump",
  "physics": "ideal"
}
