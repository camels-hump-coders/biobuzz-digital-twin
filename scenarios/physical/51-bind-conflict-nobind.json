{
  "$schema": "../scenario.schema.json",
  "name": "BIND: the same real fixed-shot request with bindings off \u2014 effective values proven before the run",
  "notes": "ignoreBindings opens the twin with ?nobind=1, so the scenario's 54 \u00b1 6 in window is the effective setting and requireEffective passes. The shooting spot is about 72 in from the cell, so the fixed-range policy should refuse the shot (no launches) and the report shows the team's range telemetry.",
  "opMode": "BioBuzz: Auto 30s + Drive",
  "alliance": "blue",
  "twinSettings": true,
  "assetOverrides": {
    "biobuzz/robot-profile.json": {
      "matchAuto.enabled": true,
      "tagTracking.autoShootEnabled": true,
      "matchAuto.driveOutIn": 6,
      "matchAuto.timeoutSeconds": 60,
      "matchAuto.startPosition": "FAR_SIDE",
      "matchAuto.loadingZoneSide": "LEFT",
      "matchAuto.loadingZoneDistanceIn": 64,
      "matchAuto.returnReserveSeconds": 10,
      "matchAuto.drivePower": 0.4,
      "matchAuto.turnPower": 0.4,
      "matchAuto.flowerDepthIn": 7,
      "matchAuto.flowerGraceIn": 4,
      "tagTracking.adaptivePower": false,
      "matchAuto.collectGarden": true,
      "matchAuto.collectOutIn": 0,
      "matchAuto.shootSpotAlongWallIn": 20,
      "matchAuto.collectBudgetSeconds": 8,
      "tagTracking.shotRangeIn": 54,
      "tagTracking.rangeToleranceIn": 6,
      "matchAuto.feedSeconds": 1.0
    },
    "biobuzz/controller-profile.json": {
      "servos.windmill.continuousRotationVerified": true
    }
  },
  "start": {
    "xIn": 63,
    "zIn": -36,
    "headingDeg": 90
  },
  "opponents": false,
  "opponentsScore": false,
  "durationS": 30,
  "inputs": [],
  "physics": "ideal",
  "ignoreBindings": true,
  "requireEffective": {
    "robot-profile.json": {
      "tagTracking.shotRangeIn": 54,
      "tagTracking.adaptivePower": false
    }
  },
  "expect": {
    "noErrors": true,
    "telemetryIncludes": [
      "Match auto : AIM_SHOOT"
    ]
  }
}
