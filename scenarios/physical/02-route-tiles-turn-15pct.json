{
  "$schema": "../scenario.schema.json",
  "name": "STALL: the same route with the turn capped at 15 % on foam tiles — the finishing turn stalls, as on the robot",
  "notes": "Handoff G03 / P0 STALL, old setting. TeamCode's finishing floor is min(MIN_TURN, turnPower), so a 15 % turn cap reproduces the 14 % command that stalled the physical robot at 81°: on the tiles profile (breakaway about 18 %) the turn stops with frozen encoders and a stall current, and the auto runs out its time budget. This fixture is EXPECTED to show stall events; it fails if the physics never stalls.",
  "opMode": "BioBuzz: Auto 30s + Drive",
  "alliance": "blue",
  "twinSettings": true,
  "assetOverrides": {
    "biobuzz/robot-profile.json": {
      "matchAuto.enabled": true,
      "tagTracking.autoShootEnabled": true,
      "matchAuto.driveOutIn": 6,
      "matchAuto.timeoutSeconds": 60,
      "matchAuto.startPosition": "FAR_SIDE",
      "matchAuto.loadingZoneSide": "LEFT",
      "matchAuto.loadingZoneDistanceIn": 64,
      "matchAuto.returnReserveSeconds": 10,
      "matchAuto.drivePower": 0.4,
      "matchAuto.turnPower": 0.15,
      "matchAuto.flowerDepthIn": 7,
      "matchAuto.flowerGraceIn": 4,
      "tagTracking.adaptivePower": true,
      "matchAuto.collectGarden": true,
      "matchAuto.collectOutIn": 0,
      "matchAuto.shootSpotAlongWallIn": 20,
      "matchAuto.collectBudgetSeconds": 8
    },
    "biobuzz/controller-profile.json": {
      "servos.windmill.continuousRotationVerified": true
    }
  },
  "start": {
    "xIn": 63,
    "zIn": -36,
    "headingDeg": -90
  },
  "opponents": false,
  "opponentsScore": false,
  "durationS": 60,
  "inputs": [],
  "physics": "tiles",
  "coverage": {
    "physics": "tiles"
  },
  "expect": {
    "noErrors": true,
    "telemetryIncludes": [
      "Match auto : TURN_ALONG_WALL"
    ],
    "stalls": ">=1",
    "eventWithin": [
      {
        "after": "Match auto : TURN_ALONG_WALL",
        "event": "stall",
        "withinS": 10
      }
    ]
  }
}
