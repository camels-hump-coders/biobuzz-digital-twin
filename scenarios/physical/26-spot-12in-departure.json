{
  "$schema": "../scenario.schema.json",
  "name": "SPOT-12: the current 12 in departure at the saved spot — report the range the code sees against the geometric truth; shot outcome recorded, not assumed",
  "notes": "SG-002 acceptance: 'do not assume 12 in succeeds before measuring it'. Same real profile and gates as SPOT-45 with the robot starting at the wall as it does on the field. The only assertions are that the route reaches the spot and that the code's range agrees with the twin's geometry; whether the solver accepts the shot there is the finding (see scenarios/physical/README.md).",
  "opMode": "BioBuzz: Auto 30s + Drive",
  "alliance": "blue",
  "twinSettings": true,
  "assetOverrides": {
    "biobuzz/robot-profile.json": {
      "matchAuto.enabled": true,
      "tagTracking.autoShootEnabled": true,
      "matchAuto.driveOutIn": 6,
      "matchAuto.timeoutSeconds": 60,
      "matchAuto.startPosition": "FAR_SIDE",
      "matchAuto.loadingZoneSide": "LEFT",
      "matchAuto.loadingZoneDistanceIn": 64,
      "matchAuto.returnReserveSeconds": 10,
      "matchAuto.flowerDepthIn": 7,
      "matchAuto.flowerGraceIn": 4,
      "matchAuto.collectGarden": true,
      "matchAuto.collectOutIn": 0,
      "matchAuto.shootSpotAlongWallIn": 20,
      "matchAuto.collectBudgetSeconds": 8,
      "matchAuto.feedSeconds": 1.0,
      "matchAuto.pauseAimTimers": false,
      "tagTracking.adaptivePower": true
    },
    "biobuzz/controller-profile.json": {
      "servos.windmill.continuousRotationVerified": true
    }
  },
  "start": {
    "xIn": 63,
    "zIn": -36,
    "headingDeg": -90
  },
  "opponents": false,
  "opponentsScore": false,
  "ignoreBindings": true,
  "physics": "ideal",
  "perception": "ideal",
  "durationS": 40,
  "requireEffective": {
    "biobuzz/robot-profile.json": {
      "tagTracking.launchAngleMeasured": true,
      "matchAuto.pauseAimTimers": false
    }
  },
  "expect": {
    "noErrors": true,
    "telemetryIncludes": [
      "Departure target : 12.0 in shooter-first",
      "Match auto : AIM_SHOOT"
    ],
    "rangeConsistency": {
      "tolIn": 4
    },
    "travelBetween": [
      {
        "after": "Match auto : DRIVE_OUT",
        "until": "Match auto : TURN_ALONG_WALL",
        "minIn": 10,
        "maxIn": 15
      }
    ]
  }
}
