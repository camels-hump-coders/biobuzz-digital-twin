  },
  "expect": {
    "noErrors": true,
    "telemetryIncludes": [
      "Shot gate : hit probability .* below the 50% minimum",
      "Match auto : AIM_SHOOT"
    ],
    "flywheelMaxPower": "==0",
    "launches": "==0",
    "eventWithin": [
      {
        "after": "Match auto : AIM_SHOOT",
        "event": "Match auto : TURN_BACK",
        "withinS": 8
      }
    ]
  }
