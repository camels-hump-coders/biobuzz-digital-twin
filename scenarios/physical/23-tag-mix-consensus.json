{
  "$schema": "../scenario.schema.json",
  "name": "TAG-MIX: the lowered cell's 40 and 41 decode as 44 and 45 — six single detections, two of them lying about their cell",
  "notes": "Handoff G06 / P0 TAG-MIX, the frame captured on the robot (42/43/45 above, 44/45 below). TeamCode's AprilTagProcessor is built with an individual-tag library, so the shim returns AprilTagSingleDetections (as the SDK does for a custom library) and TagClusterConsensus runs: the four consistent raised tags must beat the two lowered impostors and the route must still shoot. The stickers keep their ids and poses; only the decoded ids lie.",
  "opMode": "BioBuzz: Auto 30s + Drive",
  "alliance": "blue",
  "twinSettings": true,
  "assetOverrides": {
    "biobuzz/robot-profile.json": {
      "matchAuto.enabled": true,
      "tagTracking.autoShootEnabled": true,
      "matchAuto.driveOutIn": 6,
      "matchAuto.timeoutSeconds": 60,
      "matchAuto.startPosition": "FAR_SIDE",
      "matchAuto.loadingZoneSide": "LEFT",
      "matchAuto.loadingZoneDistanceIn": 64,
      "matchAuto.returnReserveSeconds": 10,
      "matchAuto.drivePower": 0.4,
      "matchAuto.turnPower": 0.4,
      "matchAuto.flowerDepthIn": 7,
      "matchAuto.flowerGraceIn": 4,
      "tagTracking.adaptivePower": true,
      "matchAuto.collectGarden": true,
      "matchAuto.collectOutIn": 0,
      "matchAuto.shootSpotAlongWallIn": 20,
      "matchAuto.collectBudgetSeconds": 8,
      "matchAuto.feedSeconds": 1.0,
      "matchAuto.pauseAimTimers": false
    },
    "biobuzz/controller-profile.json": {
      "servos.windmill.continuousRotationVerified": true
    }
  },
  "start": {
    "xIn": 63,
    "zIn": -36,
    "headingDeg": -90
  },
  "opponents": false,
  "opponentsScore": false,
  "durationS": 60,
  "inputs": [],
  "physics": "ideal",
  "perception": {
    "level": "faults",
    "faults": {
      "misreadIds": {
        "40": 44,
        "41": 45
      }
    }
  },
  "expect": {
    "noErrors": true,
    "telemetryIncludes": [
      "Match auto : AIM_SHOOT"
    ],
    "launches": ">=1"
  },
  "coverage": {
    "perception": "faults"
  }
}
